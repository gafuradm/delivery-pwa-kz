# Зависимости — устанавливаются внутри образа (важно: не перетирать linux-бинарь better-sqlite3)
node_modules
npm-debug.log*

# Git и служебные файлы
.git
.gitignore
.dockerignore

# Локальные данные и загрузки (в контейнере создаются заново)
server/db
public/uploads

# Окружение и секреты
.env
.env.example

# Артефакты, не нужные в рантайме
.playwright-mcp
test
fly.toml
PROJECT.pdf
login-snapshot.yml

# Артефакты визуальной проверки (остаётся только иконка PWA)
*.png
**/*.png
!public/icon.png

# Скриншоты и фотографии-образцы — не попадают в образ
*.jpg
*.jpeg
IMG-*
