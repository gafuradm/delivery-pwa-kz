{
  "name": "qazconhub-terminal",
  "version": "1.0.0",
  "description": "QazconHub — цифровая платформа логистического терминала (контейнеры, ППЖТ, спецтехника, пропускной режим, электронная очередь)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "seed": "node server/db.js",
    "test": "sh test/run-isolated.sh",
    "test:direct": "node test/api-test.js",
    "db:clean-test": "node tools/cleanup-test-data.js",
    "docs:pdf": "node tools/build-project-pdf.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.7.4"
  }
}
